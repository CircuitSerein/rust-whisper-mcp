# Copy to `.env` and edit for your machine: `cp .env.example .env`
# docker-compose.yml reads these. Defaults match the values baked into compose,
# so an unedited setup still behaves as before.

# Host directory mounted into the container at /data. Drop media files here;
# transcribe_file / the CLI resolve paths under this directory. Compose also
# passes this as HOST_MOUNT_ROOT so absolute host paths (e.g.
# D:\whisper-data\clip.mp4) given to transcribe_file map onto /data.
#   Windows (Docker Desktop): forward slashes, e.g. D:/whisper-data
#   Linux:                    /srv/whisper-data
WHISPER_DATA_DIR=D:/whisper-data

# Which physical GPU to expose (0-indexed). Drives both CUDA_VISIBLE_DEVICES
# inside the container and the compose device reservation.
GPU_INDEX=1

# Host port the server is published on (the container always listens on 8080).
WHISPER_PORT=17800

# Log level: error | warn | info | debug | trace
RUST_LOG=info

# --- video analysis (analyze_file / analyze_youtube / estimate_video_cost) ---

# ffmpeg hardware-accelerated decode for keyframe extraction:
#   auto  — use the GPU (NVDEC) when available, fall back to CPU (default)
#   none  — force CPU decode
#   cuda  — force CUDA (errors, then falls back to CPU, if the GPU can't)
FFMPEG_HWACCEL=auto

# Optional blended USD per 1M tokens, used only to add a `$` figure to
# estimate_video_cost. Leave empty for token counts only (the server is
# model-agnostic — set this to whatever your consuming model actually costs).
TOKEN_COST_USD_PER_MTOK=

# --- MCP transport ---

# Host authorities the /mcp endpoint accepts (comma-separated). rmcp 3 checks the
# inbound Host header to block DNS rebinding; leave empty for its loopback default
# (which already matches localhost:WHISPER_PORT). Set your hostname when running
# behind a reverse proxy, or "*" to switch the check off.
MCP_ALLOWED_HOSTS=

# --- YouTube downloads (transcribe_youtube / analyze_youtube) ---

# bgutil PO-token provider (compose starts it as the `bgutil-provider` service).
# YouTube serves media URLs only to clients presenting a PO token — without this
# every download fails with "HTTP Error 403: Forbidden".
YTDLP_POT_BASE_URL=http://bgutil-provider:4416

# Player clients yt-dlp asks for formats. tv_simply keeps plain-https formats
# once a PO token is present (web clients are SABR-only and android_vr 403s).
# Use "default" to let yt-dlp choose — try that first if YouTube changes again.
YTDLP_PLAYER_CLIENTS=tv_simply

# Optional Netscape cookies file INSIDE the container, for age-restricted or
# members-only videos. Export from your browser into WHISPER_DATA_DIR, then set
# this to /data/cookies.txt. Leave empty to run without cookies.
YTDLP_COOKIES=
