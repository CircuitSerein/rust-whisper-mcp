# Copy to `.env` and edit for your machine: `cp .env.example .env`
# docker-compose.yml reads these. Defaults match the values baked into compose,
# so an unedited setup still behaves as before.

# Host directory mounted into the container at /data. Drop media files here;
# transcribe_file / the CLI resolve paths under this directory. Compose also
# passes this as HOST_MOUNT_ROOT so absolute host paths (e.g.
# D:\whisper-data\clip.mp4) given to transcribe_file map onto /data.
#   Windows (Docker Desktop): forward slashes, e.g. D:/whisper-data
#   Linux:                    /srv/whisper-data
WHISPER_DATA_DIR=D:/whisper-data

# Which physical GPU to expose (0-indexed). Drives both CUDA_VISIBLE_DEVICES
# inside the container and the compose device reservation.
GPU_INDEX=1

# Host port the server is published on (the container always listens on 8080).
WHISPER_PORT=17800

# Log level: error | warn | info | debug | trace
RUST_LOG=info
